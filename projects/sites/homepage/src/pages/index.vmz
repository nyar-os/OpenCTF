                            <td>{{ row.patch }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="matrix__note">A detected container is not a supported one. Bytes outside every known format are only identified and hashed.</p>
        </section>

        <section class="loop">
            <div class="section-head">
                <div>
                    <span class="eyebrow">Intended loop</span>
                    <h2>Triage, unpack, decode, verify</h2>
